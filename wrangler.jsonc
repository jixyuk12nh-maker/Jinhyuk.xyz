{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jinhyuk-xyz",
  "main": "src/index.js",
  "compatibility_date": "2026-10-13",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/*", "!/style.css", "!/app.js", "!/logo.svg"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jinhyuk.xyz",
      "database_id": "69941f3a-a5d7-42d8-ad00-ba0fa8b6ec53",
      "migrations_dir": "migrations"
    }
  ]
}
